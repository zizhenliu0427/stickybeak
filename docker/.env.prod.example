# ==============================================================================
# Stickybeak Production Environment Configuration Template
# Copy this file to .env.prod and update with real credentials.
# ==============================================================================

# Release Tag
TAG=v1.0.0

# Nacos Registry & Config
NACOS_ADDR=nacos-cluster.internal:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=YourStrongNacosPassword_2026

# Relational Database (AWS RDS MySQL 8.0)
MYSQL_HOST=stickybeak-prod-mysql.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=stickybeak_admin
MYSQL_PASSWORD=YourRdsProductionPassword_!99

# Distributed Cache (AWS ElastiCache Redis 7.x)
REDIS_HOST=stickybeak-prod-redis.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=YourElastiCacheAuthToken_Secure

# Distributed Message Queue (Amazon MQ / RabbitMQ Cluster)
RABBITMQ_HOST=b-xxxx-yyyy.mq.ap-southeast-2.amazonaws.com
RABBITMQ_PORT=5672
RABBITMQ_USER=sb_mq_admin
RABBITMQ_PASSWORD=YourRabbitMqProductionPassword_Secure

# Distributed Transaction (Seata Server 2.0，order / product 结账全局事务的 TC)
# 生产 TC 建议 db 存储 + 多节点；业务库需先执行 docker/mysql/init/07-seata-undo-log.sql
SEATA_ADDR=seata-server.internal:8091

# Product Search (Elasticsearch 8.x + IK 插件)。不提供集群时保持 false，关键词搜索走 MySQL
SEARCH_ES_ENABLED=false
ES_URIS=http://elasticsearch.internal:9200

# Product media storage (S3-compatible: MinIO or AWS S3). PUBLIC_ENDPOINT must be reachable from browsers (presigned uploads)
MINIO_ENDPOINT=https://s3.ap-southeast-2.amazonaws.com
MINIO_PUBLIC_ENDPOINT=https://s3.ap-southeast-2.amazonaws.com
MINIO_USER=
MINIO_PASSWORD=
MINIO_BUCKET=stickybeak-media

# Transactional Email (Amazon SES SMTP interface; MAIL_FROM must be a verified SES identity)
MAIL_HOST=email-smtp.ap-southeast-2.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=orders@stickybeak.com.au

# Observability (SkyWalking OAP gRPC address; leave empty to run without the Java agent)
SW_AGENT_COLLECTOR_BACKEND_SERVICES=skywalking-oap.internal:11800

# AI assistant models. LLM_CHAIN is the fallback order: qwen (DashScope), deepseek, openai, gemini, ollama.
# Cloud providers without a key are skipped; leave every key empty (and no ollama) to disable the assistant.
LLM_CHAIN=qwen,deepseek
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Knowledge-base embeddings: qwen | openai | gemini | ollama | none (re-run the ingest after switching).
# Rerank only exists on DashScope; with RERANK_PROVIDER=none set RAG_MIN_VECTOR_SCORE after calibrating.
EMBEDDING_PROVIDER=qwen
RERANK_PROVIDER=qwen
RAG_MIN_VECTOR_SCORE=0

# Stripe Payment Gateway
STRIPE_API_KEY=sk_live_51Pxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Security & Authentication
# HS256 密钥，必须是 Base64 且解码后 ≥ 32 字节；auth 与 gateway 共用。
# 生成：openssl rand -base64 48 。留空时服务会拒绝启动（prod profile 不再回落到开发密钥）。
JWT_SECRET=

# SSL Certificate Directory (Must contain server.crt and server.key)
SSL_CERT_DIR=/etc/ssl/stickybeak
CERTBOT_WWW=/var/www/certbot
