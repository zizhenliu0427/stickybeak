# 本地 docker compose（docker/docker-compose.yml）的 AI 助手配置模板。
# 复制为 docker/.env 再填 key：cp docker/.env.example docker/.env
# docker/.env 已在 .gitignore 里，不会提交；不要把真实 key 写进这个 example 文件。
# agent 与 stickybeak-mcp 两个容器都读取它（env_file），改完后重建：
#   docker compose -f docker/docker-compose.yml up -d --force-recreate agent mcp

# ---- 对话模型 ----
# 降级顺序，逗号分隔：qwen（通义 DashScope）、deepseek、openai、gemini、ollama（本地）
# 前一个超时 / 限流 / 5xx / 连不上 / key 无效时自动用下一个；没填 key 的云端模型会被跳过
LLM_CHAIN=ollama,deepseek,qwen,openai,gemini

DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 走代理或兼容网关时改这里
# OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 本地 Ollama（宿主机）。compose 默认把地址设成 http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3
# 思考型模型默认关闭思考（none），否则每次调用要多等几十秒；留空使用模型默认
OLLAMA_REASONING_EFFORT=none

# 单次模型调用的超时（秒）与重试；本地大模型第一次加载进显存较慢，可以调大
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# ---- 售后知识库（RAG） ----
# 向量化：qwen | openai | gemini | ollama | none。换了之后知识库会在 MCP 启动时自动重新向量化
# ollama 默认用 bge-m3（需先 ollama pull bge-m3，原生 1024 维，与索引一致）
EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=
# 重排只有通义有（qwen）；其他情况用 none，并用向量相似度阈值判断"知识库是否覆盖了这个问题"
RERANK_PROVIDER=none
# 余弦相似度分数（(1 + cos) / 2）低于该值的片段丢掉，一条不剩就回答"不知道"；0 表示不过滤。
# 换向量模型后要重新校准（docs/SPRINT_ISSUES.md 13.4 有校准数据）。0.79 是 ollama + bge-m3 的校准值，其他模型先填 0
RAG_MIN_VECTOR_SCORE=0.79
