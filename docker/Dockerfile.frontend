# Frontend image: build the React SPA, serve via Nginx.

FROM node:20-alpine AS build
WORKDIR /app
COPY stickybeak-frontend/package.json stickybeak-frontend/package-lock.json* ./
RUN npm install
COPY stickybeak-frontend/ .
RUN npm run build

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
