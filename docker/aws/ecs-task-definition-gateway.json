{
  "family": "stickybeak-prod-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "gateway",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/stickybeak/gateway:v1.0.0",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "NACOS_ADDR", "value": "nacos-internal.<AWS_REGION>.compute.internal:8848" },
        { "name": "REDIS_HOST", "value": "stickybeak-redis.internal.<AWS_REGION>.cache.amazonaws.com" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "JAVA_OPTS", "value": "-Xms512m -Xmx1024m -XX:+UseG1GC" }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:stickybeak/prod/jwt-secret"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/actuator/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 40
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/stickybeak-prod",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "gateway"
        }
      }
    }
  ]
}
