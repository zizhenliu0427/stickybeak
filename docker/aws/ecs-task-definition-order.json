{
  "family": "stickybeak-prod-order",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "order",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/stickybeak/order:v1.0.0",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8084,
          "hostPort": 8084,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "NACOS_ADDR", "value": "nacos-internal.<AWS_REGION>.compute.internal:8848" },
        { "name": "MYSQL_HOST", "value": "stickybeak-db.rds.amazonaws.com" },
        { "name": "MYSQL_PORT", "value": "3306" },
        { "name": "MYSQL_USER", "value": "stickybeak_order_user" },
        { "name": "REDIS_HOST", "value": "stickybeak-redis.internal.<AWS_REGION>.cache.amazonaws.com" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "RABBITMQ_HOST", "value": "stickybeak-mq.mq.<AWS_REGION>.amazonaws.com" },
        { "name": "RABBITMQ_PORT", "value": "5672" },
        { "name": "JAVA_OPTS", "value": "-Xms512m -Xmx1536m -XX:+UseG1GC" }
      ],
      "secrets": [
        {
          "name": "MYSQL_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:stickybeak/prod/db-order-password"
        },
        {
          "name": "REDIS_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:stickybeak/prod/redis-password"
        },
        {
          "name": "RABBITMQ_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:stickybeak/prod/rabbitmq-password"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8084/actuator/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 50
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/stickybeak-prod",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "order"
        }
      }
    }
  ]
}
